{
  "metadata": [
    {
      "src": [
        {
          "files": ["WAD.NET/WAD.NET.csproj"],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "netstandard2.1"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "WAD.NET",
      "_appName": "WAD.NET",
      "_appFooter": "WAD.NET - A .NET library for DOOM WAD files",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/daerogami/WAD.NET",
        "branch": "dev"
      }
    },
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
